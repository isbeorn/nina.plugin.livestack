    <local:MinusOneToIgnoreStringConverter x:Key="MinusOneToIgnoreStringConverter" />
    <s:String x:Key="WorkingDirectoryTooltip">Livestack uses this folder for temporary FITS files, optional calibrated frames, and saved stack output.</s:String>
    <s:String x:Key="BrowseWorkingDirectoryTooltip">Browse for the working directory used by Livestack.</s:String>
    <s:String x:Key="UseBiasForLightsTooltip">When enabled, Livestack applies matching bias masters while calibrating light and snapshot frames.</s:String>
    <s:String x:Key="HotpixelRemovalTooltip">Applies hot-pixel cleanup after calibration and before the frame is added to the stack.</s:String>
    <s:String x:Key="SaveCalibratedFlatsTooltip">Keeps the calibrated flat FITS files created by Stack flats. When off, they are deleted after the flat master is generated.</s:String>
    <s:String x:Key="SaveCalibratedLightsTooltip">Saves calibrated light FITS files in the working directory under calibrated\light.</s:String>
    <s:String x:Key="SaveStackedLightsTooltip">Automatically saves updated stack output in the working directory. Monochrome and channel stacks are saved as FITS files, and RGB combination stacks are saved as PNG files.</s:String>
    <s:String x:Key="DefaultStretchTooltip">Initial stretch value used when new mono and RGB stack tabs are created.</s:String>
    <s:String x:Key="DefaultBlackClippingTooltip">Initial black-clipping value used when new mono and RGB stack tabs are created.</s:String>
    <s:String x:Key="DefaultEnableBackgroundExtractionTooltip">Experimental background extraction for new mono and RGB stack tabs. It only changes the displayed preview, not saved FITS stack data. Disable it if it suppresses real nebulosity, galaxy halos, or creates blotchy gradients.</s:String>
    <s:String x:Key="DefaultBackgroundExtractionAmountTooltip">Initial strength for the experimental background extraction. Lower values preserve more of the original background; higher values remove more large-scale gradients.</s:String>
    <s:String x:Key="DefaultEnableGreenDeNoiseTooltip">Sets whether green de-noise starts enabled on new RGB combination tabs.</s:String>
    <s:String x:Key="DefaultGreenDeNoiseAmountTooltip">Initial green de-noise amount used on new RGB combination tabs.</s:String>
    <s:String x:Key="DefaultDownsampleTooltip">Initial preview downsample factor used when new mono and RGB stack tabs are created.</s:String>
    <s:String x:Key="BiasLibraryTooltip">Bias masters available to Livestack calibration.</s:String>
    <s:String x:Key="DarkLibraryTooltip">Dark masters available to Livestack calibration.</s:String>
    <s:String x:Key="FlatLibraryTooltip">Multi-session flat masters available to Livestack calibration.</s:String>
    <s:String x:Key="AddCalibrationMasterTooltip">Import a FITS master into the Bias, Dark, or Multi Session Flat library.</s:String>

    <!--  This data template will be displayed in N.I.N.A. on the options->plugin tab with the datacontext of the TestPlugin instance  -->
    <!--  In order for this datatemplate to be picked correctly, the key has to follow the naming convention of <IPlugin.Name>_Options -->
    <!--  Furthermore the Resource Dictionary has to be exported via code behind export attributes  -->
    <DataTemplate x:Key="Livestack_Options">
        <TabControl>
            <TabItem Header="Settings">
                <StackPanel Grid.IsSharedSizeScope="True" Orientation="Vertical">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Text="Working Directory"
                            ToolTip="{StaticResource WorkingDirectoryTooltip}" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            Orientation="Horizontal">
                            <TextBox
                                MinWidth="150"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                ToolTip="{StaticResource WorkingDirectoryTooltip}">
                                <TextBox.Text>
                                    <Binding Path="WorkingDirectory" UpdateSourceTrigger="LostFocus">
                                        <Binding.ValidationRules>
                                            <rules:DirectoryExistsRule />
                                        </Binding.ValidationRules>
                                    </Binding>
                                </TextBox.Text>
                            </TextBox>

                            <Button
                                Width="20"
                                Height="20"
                                Margin="5,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Command="{Binding OpenWorkingFolderDiagCommand}"
                                ToolTip="{StaticResource BrowseWorkingDirectoryTooltip}">
                                <Path
                                    Margin="2,10,2,0"
                                    Data="{StaticResource DotsSVG}"
                                    Fill="{StaticResource ButtonForegroundBrush}"
                                    Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Use Bias for Lights"
                            ToolTip="{StaticResource UseBiasForLightsTooltip}" />
                        <CheckBox
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding UseBiasForLights, Mode=TwoWay}"
                            ToolTip="{StaticResource UseBiasForLightsTooltip}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Hotpixel removal"
                            ToolTip="{StaticResource HotpixelRemovalTooltip}" />
                        <CheckBox
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding HotpixelRemoval, Mode=TwoWay}"
                            ToolTip="{StaticResource HotpixelRemovalTooltip}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Save calibrated Flats?"
                            ToolTip="{StaticResource SaveCalibratedFlatsTooltip}" />
                        <CheckBox
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding SaveCalibratedFlats, Mode=TwoWay}"
                            ToolTip="{StaticResource SaveCalibratedFlatsTooltip}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Save calibrated Lights?"
                            ToolTip="{StaticResource SaveCalibratedLightsTooltip}" />
                        <CheckBox
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding SaveCalibratedLights, Mode=TwoWay}"
                            ToolTip="{StaticResource SaveCalibratedLightsTooltip}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Autosave stacked Lights?"
                            ToolTip="{StaticResource SaveStackedLightsTooltip}" />
                        <CheckBox
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding SaveStackedLights, Mode=TwoWay}"
                            ToolTip="{StaticResource SaveStackedLightsTooltip}" />
                    </Grid>

                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Default stretch factor"
                            ToolTip="{StaticResource DefaultStretchTooltip}" />
                        <ninactrl:StepperControl
                            Grid.Column="1"
                            MinWidth="100"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            MaxValue="1"
                            MinValue="0"
                            StepSize="0.01"
                            ToolTip="{StaticResource DefaultStretchTooltip}"
                            Value="{Binding DefaultStretchAmount, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Default black clipping"
                            ToolTip="{StaticResource DefaultBlackClippingTooltip}" />
                        <ninactrl:StepperControl
                            Grid.Column="1"
                            MinWidth="100"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            MaxValue="0"
                            MinValue="-10"
                            StepSize="0.1"
                            ToolTip="{StaticResource DefaultBlackClippingTooltip}"
                            Value="{Binding DefaultBlackClipping, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Default background extraction?"
                            ToolTip="{StaticResource DefaultEnableBackgroundExtractionTooltip}" />
                        <CheckBox
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding DefaultEnableBackgroundExtraction, Mode=TwoWay}"
                            ToolTip="{StaticResource DefaultEnableBackgroundExtractionTooltip}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Default background extraction amount"
                            ToolTip="{StaticResource DefaultBackgroundExtractionAmountTooltip}" />
                        <ninactrl:StepperControl
                            Grid.Column="1"
                            MinWidth="100"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            MaxValue="1"
                            MinValue="0"
                            StepSize="0.1"
                            ToolTip="{StaticResource DefaultBackgroundExtractionAmountTooltip}"
                            Value="{Binding DefaultBackgroundExtractionAmount, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Default green de-noise on?"
                            ToolTip="{StaticResource DefaultEnableGreenDeNoiseTooltip}" />
                        <CheckBox
                            Grid.Column="1"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            IsChecked="{Binding DefaultEnableGreenDeNoise, Mode=TwoWay}"
                            ToolTip="{StaticResource DefaultEnableGreenDeNoiseTooltip}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Default green de-noise amount"
                            ToolTip="{StaticResource DefaultGreenDeNoiseAmountTooltip}" />
                        <ninactrl:StepperControl
                            Grid.Column="1"
                            MinWidth="100"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            MaxValue="1"
                            MinValue="0"
                            StepSize="0.1"
                            ToolTip="{StaticResource DefaultGreenDeNoiseAmountTooltip}"
                            Value="{Binding DefaultGreenDeNoiseAmount, Mode=TwoWay}" />
                    </Grid>
                    <Grid Margin="0,5,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Livestack_Label" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            VerticalAlignment="Center"
                            Text="Default downsample factor"
                            ToolTip="{StaticResource DefaultDownsampleTooltip}" />
                        <ninactrl:IntStepperControl
                            Grid.Column="1"
                            MinWidth="100"
                            Margin="5,0,0,0"
                            HorizontalAlignment="Left"
                            MaxValue="4"
                            MinValue="1"
                            StepSize="1"
                            ToolTip="{StaticResource DefaultDownsampleTooltip}"
                            Value="{Binding DefaultDownsample, Mode=TwoWay}" />
                    </Grid>
                    <GroupBox
                        x:Name="PART_BiasLibrary"
                        Margin="0,5,0,0"
                        DataContext="{x:Static local:LivestackMediator.CalibrationVM}"
                        Header="Bias Library"
                        ToolTip="{StaticResource BiasLibraryTooltip}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                ItemsSource="{Binding BiasLibrary}"
                                SelectionMode="Single"
                                ToolTip="{StaticResource BiasLibraryTooltip}"
                                VerticalScrollBarVisibility="Auto">
                                <i:Interaction.Behaviors>
                                    <behavior:BubbleScrollEvent />
                                </i:Interaction.Behaviors>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="4*" Header="File Location">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Path}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Width">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Width}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Height">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Height}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Gain">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Gain, Converter={StaticResource MinusOneToIgnoreStringConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Offset">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Offset, Converter={StaticResource MinusOneToIgnoreStringConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Bin X">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding BinX, Converter={StaticResource MinusOneToIgnoreStringConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Bin Y">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding BinY, Converter={StaticResource MinusOneToIgnoreStringConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="30" Header="">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Command="{Binding DataContext.DeleteBiasMasterCommand, ElementName=PART_BiasLibrary}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BackgroundButton}">
                                                    <Path
                                                        Height="15"
                                                        Margin="0"
                                                        Data="{StaticResource TrashCanSVG}"
                                                        Fill="{StaticResource ButtonForegroundBrush}"
                                                        Stretch="Uniform" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                    <GroupBox
                        x:Name="PART_DarkLibrary"
                        Margin="0,5,0,0"
                        DataContext="{x:Static local:LivestackMediator.CalibrationVM}"
                        Header="Dark Library"
                        ToolTip="{StaticResource DarkLibraryTooltip}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                ItemsSource="{Binding DarkLibrary}"
                                SelectionMode="Single"
                                ToolTip="{StaticResource DarkLibraryTooltip}"
                                VerticalScrollBarVisibility="Auto">
                                <i:Interaction.Behaviors>
                                    <behavior:BubbleScrollEvent />
                                </i:Interaction.Behaviors>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="2*" Header="File Location">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Path}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Exposure Time">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding ExposureTime}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Width">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Width}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Height">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Height}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Gain">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Gain, Converter={StaticResource MinusOneToIgnoreStringConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Offset">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Offset, Converter={StaticResource MinusOneToIgnoreStringConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Bin X">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding BinX, Converter={StaticResource MinusOneToIgnoreStringConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Bin Y">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding BinY, Converter={StaticResource MinusOneToIgnoreStringConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="30" Header="">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Command="{Binding DataContext.DeleteDarkMasterCommand, ElementName=PART_DarkLibrary}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BackgroundButton}">
                                                    <Path
                                                        Height="15"
                                                        Margin="0"
                                                        Data="{StaticResource TrashCanSVG}"
                                                        Fill="{StaticResource ButtonForegroundBrush}"
                                                        Stretch="Uniform" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                    <GroupBox
                        x:Name="PART_FlatLibrary"
                        Margin="0,5,0,0"
                        DataContext="{x:Static local:LivestackMediator.CalibrationVM}"
                        Header="Multi Session Flat Library"
                        ToolTip="{StaticResource FlatLibraryTooltip}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DataGrid
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                ItemsSource="{Binding FlatLibrary}"
                                SelectionMode="Single"
                                ToolTip="{StaticResource FlatLibraryTooltip}"
                                VerticalScrollBarVisibility="Auto">
                                <i:Interaction.Behaviors>
                                    <behavior:BubbleScrollEvent />
                                </i:Interaction.Behaviors>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="2*" Header="File Location">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Path}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Filter">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Filter}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Width">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Width}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Height">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Height}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Bin X">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding BinX, Converter={StaticResource MinusOneToIgnoreStringConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="*" Header="Bin Y">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding BinY, Converter={StaticResource MinusOneToIgnoreStringConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="30" Header="">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Command="{Binding DataContext.DeleteFlatMasterCommand, ElementName=PART_FlatLibrary}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource BackgroundButton}">
                                                    <Path
                                                        Height="15"
                                                        Margin="0"
                                                        Data="{StaticResource TrashCanSVG}"
                                                        Fill="{StaticResource ButtonForegroundBrush}"
                                                        Stretch="Uniform" />
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                    <Button
                        Command="{Binding AddCalibrationFrameCommand}"
                        DataContext="{x:Static local:LivestackMediator.CalibrationVM}"
                        ToolTip="{StaticResource AddCalibrationMasterTooltip}">
                        Add Calibration Master
                    </Button>
                </StackPanel>
            </TabItem>
            <TabItem Header="Workflow">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,8,10,10" Orientation="Vertical">
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="Workflow Guide" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Text="Use this page as a quick reference for setup, calibration, live stacking, flat stacking, and saved output."
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,12,0,0"
                            FontWeight="SemiBold"
                            Text="1. Initial setup" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="Set Working Directory to an existing folder. Livestack uses it for temporary FITS files, optional calibrated frames, and saved stack files."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="Add calibration masters here if you want them used during calibration. This page manages the Bias Library, Dark Library, and Multi Session Flat Library."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="The default stretch, black clipping, experimental background extraction, green de-noise, and downsample values on this page are used when new stack tabs are created. Background extraction is preview-only and should be disabled when it removes real target signal or creates blotchy gradients."
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,12,0,0"
                            FontWeight="SemiBold"
                            Text="2. Start and stop live stacking" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="Open the Live Stack dockable and use Start Live Stack before capturing frames. If you use the sequencer, the Livestack category also includes Start live stacking and Stop live stacking items."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="Live stacking works with LIGHT and SNAPSHOT images."
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,12,0,0"
                            FontWeight="SemiBold"
                            Text="3. What happens to each light frame" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="Each LIGHT or SNAPSHOT frame is first written into the working directory. If star detection results are not already present, Livestack runs star detection before stacking."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="Frames with fewer than 8 detected stars are skipped. Frames can also be rejected by Quality Gates, which you configure in the Live Stack dockable."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="Accepted frames are calibrated with the currently registered masters, optional hot-pixel removal is applied, the frame is aligned, and it is added to the matching target and filter tab."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="For one-shot color data, Livestack creates separate red, green, and blue stack tabs and also creates an RGB combination tab for the same target."
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,12,0,0"
                            FontWeight="SemiBold"
                            Text="4. Flat-frame workflow" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="The Live Stack dockable has a Single Session Flat Library. Those session flats are used together with the Multi Session Flat Library when light frames are calibrated."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="You can add a session flat manually in the dockable with Add Flat Master, or you can use the Stack flats sequencer item."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="Stack flats collects FLAT images inside the current instruction set, calibrates them in the background, requires at least 3 flats per filter to build a master, saves the master in the working directory, and adds it to the Single Session Flat Library. If Save calibrated Flats is off, the calibrated flat files are deleted after the master is built."
                            TextWrapping="Wrap" />

                        <TextBlock
                            Margin="0,12,0,0"
                            FontWeight="SemiBold"
                            Text="5. Saved output" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="Save calibrated Lights saves calibrated FITS files in the working directory under calibrated\light."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="Autosave stacked Lights saves monochrome and channel stacks as FITS files in the working directory under stacks. RGB combination autosaves are PNG files in the same folder."
                            TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="The Live Stack dockable also has an Add color combination action for building an RGB tab from existing channels."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type prompts:CalibrationFramePrompt}">
        <DataTemplate.Resources>
            <ObjectDataProvider
                x:Key="dataFromEnum"
                MethodName="GetValues"
                ObjectType="{x:Type s:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type TypeName="image:CalibrationFrameType" />
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </DataTemplate.Resources>
        <StackPanel Margin="5" Orientation="Vertical">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock>File Location</TextBlock>
                <TextBlock
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Text="{Binding Context.Path}" />

                <TextBlock Grid.Row="1">Image Type</TextBlock>
                <ComboBox
                    x:Name="PART_Type"
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    ItemsSource="{Binding Source={StaticResource dataFromEnum}}"
                    SelectedItem="{Binding Context.Type}" />

                <TextBlock Grid.Row="2">Width</TextBlock>
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Text="{Binding Context.Width}" />

                <TextBlock Grid.Row="3">Height</TextBlock>
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    Text="{Binding Context.Height}" />

                <TextBlock Grid.Row="4">Bin X</TextBlock>
                <ninactrl:HintTextBox
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    HintText="Ignore"
                    Text="{Binding Context.BinX, Converter={StaticResource MinusOneToEmptyStringConverter}}" />

                <TextBlock Grid.Row="5">Bin Y</TextBlock>
                <ninactrl:HintTextBox
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="5,0,0,0"
                    VerticalAlignment="Center"
                    HintText="Ignore"
                    Text="{Binding Context.BinY, Converter={StaticResource MinusOneToEmptyStringConverter}}" />

                <Grid Grid.Row="6">
                    <TextBlock>Filter</TextBlock>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=PART_Type, Path=SelectedIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=PART_Type, Path=SelectedIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>
                <Grid
                    Grid.Row="6"
                    Grid.Column="1"
                    Margin="5,0,0,0">
                    <TextBox Text="{Binding Context.Filter}" />
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=PART_Type, Path=SelectedIndex}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=PART_Type, Path=SelectedIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>

                <Grid Grid.Row="7">
                    <TextBlock>Exposure Time</TextBlock>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=PART_Type, Path=SelectedIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=PART_Type, Path=SelectedIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>
                <Grid
                    Grid.Row="7"
                    Grid.Column="1"
                    Margin="5,0,0,0">
                    <TextBox Text="{Binding Context.ExposureTime}" />
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=PART_Type, Path=SelectedIndex}" Value="1">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ElementName=PART_Type, Path=SelectedIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>

                <Grid Grid.Row="8">
                    <TextBlock>Gain</TextBlock>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=PART_Type, Path=SelectedIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>
                <Grid
                    Grid.Row="8"
                    Grid.Column="1"
                    Margin="5,0,0,0">
                    <ninactrl:HintTextBox
                        VerticalAlignment="Center"
                        HintText="Ignore"
                        Text="{Binding Context.Gain, Converter={StaticResource MinusOneToEmptyStringConverter}}" />
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=PART_Type, Path=SelectedIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>

                <Grid Grid.Row="9">
                    <TextBlock>Offset</TextBlock>
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=PART_Type, Path=SelectedIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>
                <Grid
                    Grid.Row="9"
                    Grid.Column="1"
                    Margin="5,0,0,0">
                    <ninactrl:HintTextBox
                        VerticalAlignment="Center"
                        HintText="Ignore"
                        Text="{Binding Context.Offset, Converter={StaticResource MinusOneToEmptyStringConverter}}" />
                    <Grid.Style>
                        <Style TargetType="{x:Type Grid}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=PART_Type, Path=SelectedIndex}" Value="2">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                </Grid>

                <Button
                    Grid.Row="10"
                    Height="25"
                    Margin="5"
                    util:ButtonHelper.DialogResult="False">
                    <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="{ns:Loc LblCancel}" />
                </Button>

                <Button
                    Grid.Row="10"
                    Grid.Column="1"
                    Height="25"
                    Margin="5"
                    util:ButtonHelper.DialogResult="True"
                    Command="{Binding ContinueCommand}">
                    <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="{ns:Loc LblOK}" />
                </Button>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type prompts:QualityGatePrompt}">
        <Grid Margin="2.5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Quality Gate" />
            <ComboBox
                Grid.Column="1"
                Margin="5,0,0,0"
                DisplayMemberPath="Name"
                ItemsSource="{Binding AvailableGates}"
                SelectedItem="{Binding SelectedGate}" />

            <Button
                Grid.Row="4"
                Height="25"
                Margin="5"
                util:ButtonHelper.DialogResult="False">
                <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="{ns:Loc LblCancel}" />
            </Button>

            <Button
                Grid.Row="4"
                Grid.Column="1"
                Height="25"
                Margin="5"
                util:ButtonHelper.DialogResult="True"
                Command="{Binding ContinueCommand}">
                <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="{ns:Loc LblOK}" />
            </Button>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type prompts:ColorCombinationPrompt}">
        <Grid Margin="2.5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock VerticalAlignment="Center" Text="Target" />
            <ComboBox
                Grid.Column="1"
                Margin="5,0,0,0"
                ItemsSource="{Binding Targets}"
                SelectedItem="{Binding Target}" />

            <TextBlock
                Grid.Row="1"
                VerticalAlignment="Center"
                Text="Red Channel" />
            <ComboBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="5,0,0,0"
                DisplayMemberPath="Filter"
                ItemsSource="{Binding FilterTabs}"
                SelectedItem="{Binding RedChannel}" />

            <TextBlock
                Grid.Row="2"
                VerticalAlignment="Center"
                Text="Green Channel" />
            <ComboBox
                Grid.Row="2"
                Grid.Column="1"
                Margin="5,0,0,0"
                DisplayMemberPath="Filter"
                ItemsSource="{Binding FilterTabs}"
                SelectedItem="{Binding GreenChannel}" />

            <TextBlock
                Grid.Row="3"
                VerticalAlignment="Center"
                Text="Blue Channel" />
            <ComboBox
                Grid.Row="3"
                Grid.Column="1"
                Margin="5,0,0,0"
                DisplayMemberPath="Filter"
                ItemsSource="{Binding FilterTabs}"
                SelectedItem="{Binding BlueChannel}" />

            <!--<TextBlock
                Grid.Row="4"
                VerticalAlignment="Center"
                Text="Color Stack Every #" />
            <TextBox
                Grid.Row="4"
                Grid.Column="1"
                Margin="5,0,0,0"
                VerticalContentAlignment="Center"
                Text="{Binding StackEachNrOfFrames}" />-->

            <Button
                Grid.Row="5"
                Height="25"
                Margin="5"
                util:ButtonHelper.DialogResult="False">
                <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="{ns:Loc LblCancel}" />
            </Button>

            <Button
                Grid.Row="5"
                Grid.Column="1"
                Height="25"
                Margin="5"
                util:ButtonHelper.DialogResult="True"
                Command="{Binding ContinueCommand}">
                <TextBlock Foreground="{StaticResource ButtonForegroundBrush}" Text="{ns:Loc LblOK}" />
            </Button>
        </Grid>
    </DataTemplate>
</ResourceDictionary>